# ====================================
# Prisma Studio Dockerfile
# ====================================
FROM node:20-alpine

WORKDIR /app

# 의존성 설치
COPY package*.json ./
RUN npm ci --omit=dev

COPY prisma.config.ts ./

# Prisma 스키마 복사 및 클라이언트 생성
COPY prisma ./prisma/
RUN npx prisma generate

EXPOSE 51212

# Prisma Studio 실행
CMD ["npx", "prisma", "studio", "--port", "51212", "--browser", "none", "--config", "./prisma.config.ts"]
