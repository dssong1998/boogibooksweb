// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                 String    @id @default(uuid())
  title              String
  content            String?
  date               DateTime
  location           String
  eventType          EventType @default(MEETING)
  price              Int       @default(30000) // 기본 가격 3만원
  maxParticipants    Int
  requiredCoins      Int       @default(0)
  applications       EventApplication[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum EventType {
  MEETING      // 대면모임 (30,000원)
  DIGGING_CLUB // 디깅클럽 (15,000원)
  ONLINE       // 온라인 (무료 또는 별도)
  BOOGITOUT    // 부깃아웃
  OTHER        // 기타
}

model EventApplication {
  id                  String                    @id @default(uuid())
  eventId             String
  event               Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  applicationOrder    Int                       // 신청 순번
  status              EventApplicationStatus    @default(PENDING)
  usedCoins           Int                       @default(0)
  libraryMessageCount Int                       @default(0) // 서재 활동 수 (신청 시점)
  isNewMember         Boolean                   @default(false) // 뉴멤버 여부 (신청 시점)
  paidAt              DateTime?                 // 결제 완료 시간
  approvedAt          DateTime?                 // 관리자 승인 시간
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([eventId, userId])
}

enum EventApplicationStatus {
  PENDING         // 신청 대기 (관리자 승인 전)
  APPROVED        // 관리자 승인됨 (결제 대기)
  CONFIRMED       // 확정 (결제 완료 또는 테라스 멤버)
  COIN_GUARANTEED // 코인 사용으로 정원 외 보장
  CANCELLED       // 취소됨
}

model User {
  id                    String    @id @default(uuid())
  discordId             String    @unique
  username              String
  email                 String?
  role                  UserRole  @default(VISITOR)
  isTerras              Boolean   @default(false) // 테라스 멤버 여부
  isNewMember           Boolean   @default(false) // 뉴멤버 여부 (첫 모임 무료)
  coins                 Int       @default(0)
  books                 Book[]
  comments              Comment[]
  diggings              Digging[]
  eventApplications     EventApplication[]
  boogiOutEventsCreated BoogiOutEvent[]
  boogiOutApplications  BoogiOutApplication[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// 부깃아웃(BoogiOut) — 커뮤니티 기획 모임 (기존 Event 모델과 별도)
model BoogiOutEvent {
  id          String @id @default(uuid())
  creatorId   String
  creator     User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  title       String
  description String @db.Text
  location    String

  costMode         BoogiOutCostMode
  costAmount       Int // TOTAL: 총 비용(원), PER_PERSON: 1인당 비용(원)
  feePercent       Int                  @default(10)
  settlementMode   BoogiOutSettlementMode
  /** 예상 가격(신청자 노출) = 총액 모드: costAmount/demandParticipants, 1인당 모드: costAmount */
  demandParticipants Int                @default(1)
  /** settlementMode COMMISSION(현금성 정산) 시 입금 안내용 */
  commissionBankName       String?
  commissionAccountNumber  String?
  maxParticipants  Int?

  timeMode               BoogiOutTimeMode
  eventDate              DateTime?
  targetHeadcount        Int?
  dateSelectionMockupUrl String?

  applicantResponseEnabled Boolean @default(false)
  applicantResponseLabel   String?

  afterPartyEnabled         Boolean @default(false)
  afterPartyBudgetPerPerson Int?
  afterPartyTotalAmount     Int?
  afterPartyBankName        String?
  afterPartyAccountNumber   String?
  afterPartySettledAt       DateTime?

  promotionalImageUrl String?
  paymentLink         String?

  status BoogiOutEventStatus

  reminder3dAt         DateTime?
  registrationClosesAt DateTime?
  reminder3dSentAt     DateTime?
  registrationClosedAt DateTime?
  postCloseDmSentAt    DateTime?

  headcountReachedNotifiedAt DateTime?

  discordPromoMessageId String?
  discordThreadId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications BoogiOutApplication[]
  outbox       BoogiOutDiscordOutbox[]
}

enum BoogiOutCostMode {
  TOTAL
  PER_PERSON
}

enum BoogiOutSettlementMode {
  COMMISSION
  COIN_GAIN
}

enum BoogiOutTimeMode {
  CONFIRMED
  SET_TOGETHER
}

enum BoogiOutEventStatus {
  STANDBY
  IN_PROGRESS
  CLOSED_REGISTRATION
  COMPLETED
  CANCELLED
}

model BoogiOutApplication {
  id       String @id @default(uuid())
  eventId  String
  event    BoogiOutEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responseText String?
  /** 뒷풀이 ON일 때만: true/false. 뒷풀이 OFF 이벤트는 null */
  afterPartyOptIn Boolean?

  status BoogiOutApplicationStatus @default(PENDING)
  proofToken String @unique @default(uuid())
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

enum BoogiOutApplicationStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

model BoogiOutDiscordOutbox {
  id      String @id @default(uuid())
  kind    String
  payload Json
  status  String  @default("PENDING")
  error   String?

  eventId String?
  event   BoogiOutEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  processedAt DateTime?
}
enum BoogiOutDiscordOutboxKind {
  CREATE_PROMO
  NEW_APPLICATION_PLANNER_DM
  STANDBY_HEADCOUNT_MET
  REMINDER_3D_CHANNEL
  POST_CLOSE_DM
  AFTER_PARTY_SPLIT
  CREATE_ATTENDANCE_THREAD
}
enum BoogiOutDiscordOutboxStatus {
  PENDING
  DONE
  FAILED
}

model Book {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordThreadId String? @unique
  title       String
  author      String
  isbn        String?
  publisher   String?
  coverUrl    String?
  description String?
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Comment {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  discordMessageId String? @unique
  type      CommentType @default(REVIEW)
  content   String
  page      Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum CommentType {
  PREVIEW // 프리뷰
  REVIEW  // 리뷰
  QUOTE   // 인용과 감상
}

model Digging {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  title       String?  // 링크 제목
  description String   // 메시지 본문
  thumbnail   String?  // 썸네일 이미지 URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 식탁 방명록 (음성 채널 참여 기록)
model TableLog {
  id            String   @id @default(uuid())
  discordUserId String   // Discord User ID (User와 별도 - 아직 가입 안 한 유저도 기록)
  date          DateTime // 참여 날짜
  channelName   String?  // 채널 이름 (식탁, 야식탁 등)
  messageId     String?  @unique // Discord 메시지 ID (중복 방지)
  createdAt     DateTime @default(now())

  @@index([discordUserId])
  @@index([date])
}

model MonthlyBook {
  id             String   @id @default(uuid())
  year           Int
  month          Int
  topic          String?  // 이달의 주제
  title          String
  author         String
  isbn           String?
  publisher      String?
  coverUrl       String?
  description    String?
  recommendation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([year, month]) // 같은 월에 여러 책 등록 가능
}

model Schedule {
  id          String       @id @default(uuid())
  title       String
  description String?
  date        DateTime
  time        String?
  type        ScheduleType @default(MEETING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ScheduleType {
  MEETING      // 모임
  SHELLCAST    // 쉘캐스트
  DIGGING_CLUB // 디깅클럽
  MOVIE_NIGHT  // 무비나잇
  BOOGITOUT    // 부깃아웃
}

enum UserRole {
  VISITOR
  MEMBER
  ADMIN
}
// 테라스 멤버 여부는 User.isTerras 필드로 관리

// 디스코드 봇이 서재(포럼) 활동을 푸시할 때 집계
// messageCount: 유효/비유효 포함 전체 기록 건수
// validForEventCount: 이벤트 신청 자격 판단용(Preview/리뷰 규칙 등) 충족 건수
model LibraryActivityMonth {
  id                 String   @id @default(uuid())
  discordUserId      String
  year               Int
  month              Int
  messageCount       Int      @default(0)
  validForEventCount Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@unique([discordUserId, year, month])
  @@index([discordUserId])
}

// 동일 Discord 이벤트(메시지/스레드) 중복 반영 방지
model LibraryActivityAck {
  id                String   @id @default(uuid())
  sourceId          String   @unique
  discordUserId     String
  isValidForEvent   Boolean  @default(false)
  createdAt         DateTime @default(now())
}