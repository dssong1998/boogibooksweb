# ====================================
# 부기북스 프로덕션 환경 변수 (Docker)
# ====================================
# cp env.production.example .env

# ====================================
# 도메인 & SSL (init 시 사용)
# ====================================
DOMAIN=boogibooks.com
EMAIL=your-email@example.com

# ====================================
# 데이터베이스 (Docker 내부 PostgreSQL)
# ====================================
POSTGRES_USER=boogibooks
POSTGRES_PASSWORD=여기에_강력한_비밀번호
POSTGRES_DB=boogibooks

# ====================================
# JWT 시크릿
# ====================================
# 생성: openssl rand -base64 32
JWT_SECRET=여기에_랜덤_시크릿_키

# ====================================
# Frontend & Backend URL
# ====================================
VITE_API_BASE_URL=https://api.boogibooks.com
FRONTEND_URL=https://boogibooks.com
# 부깃아웃 DM 내 링크(결제/증명 페이지) — 백엔드에서 사용
# FRONTEND_URL과 동일하게 두면 됩니다.
BACKEND_API_URL=https://api.boogibooks.com

# ====================================
# Discord 봇 ↔ 백엔드 (서재 활동 실시간 반영)
# ====================================
# 백엔드와 discord-bot에 동일한 값으로 설정 (openssl rand -base64 32)
BOT_INTERNAL_SECRET=여기에_랜덤_시크릿_키

# ====================================
# Discord OAuth & Bot
# ====================================
DISCORD_CLIENT_ID=여기에_디스코드_클라이언트_ID
DISCORD_CLIENT_SECRET=여기에_디스코드_클라이언트_시크릿
DISCORD_REDIRECT_URI=https://api.boogibooks.com/auth/discord/callback
DISCORD_BOT_TOKEN=여기에_봇_토큰
DISCORD_GUILD_ID=여기에_서버_ID

# Discord 역할 ID
DISCORD_TERRAS_ROLE_ID=여기에_테라스_역할_ID
DISCORD_MEMBER_ROLE_ID=여기에_멤버_역할_ID

# Discord 채널 ID
DISCORD_LIBRARY_CHANNEL_ID=여기에_서재_채널_ID
BOOKS_CHANNEL_ID=여기에_서재_채널_ID
DIGGING_CHANNEL_ID=여기에_디깅_채널_ID
TABLE_LOG_CHANNEL_ID=여기에_식탁방명록_채널_ID
# 부깃아웃 홍보/공지/스레드 (거실 텍스트 채널) — discord-bot이 읽는 변수명
LIVING_ROOM_CHANNEL_ID=여기에_거실_채널_ID

# ====================================
# 관리자 Discord ID
# ====================================
ADMIN_ID1=여기에_관리자_디스코드_ID
ADMIN_ID2=
ADMIN_ID3=

# ====================================
# Naver API (책 검색)
# ====================================
NAVER_CLIENT_ID=여기에_네이버_클라이언트_ID
NAVER_CLIENT_SECRET=여기에_네이버_클라이언트_시크릿

# ====================================
# Vultr Object Storage (S3 호환 — 부깃아웃 홍보 이미지 업로드)
# ====================================
# docker-compose의 backend 서비스에 그대로 전달됩니다.
# 아래 네 가지(ENDPOINT, BUCKET, ACCESS_KEY, SECRET_KEY)를 모두 채워야 업로드가 동작합니다.
# 비워 두면 다른 기능은 그대로이고, 홍보 이미지 업로드만 API에서 사용 불가(503) 처리됩니다.
# ENDPOINT 호스트(예: ewr1.vultrobjects.com)와 REGION 값은 같은 리전이어야 합니다.
# 업로드 시 ACL public-read를 쓰므로, 버킷/객체가 브라우저에서 읽히도록 Vultr 쪽 공개 읽기 정책을 맞춰 두세요.
# 리전별 엔드포인트: https://docs.vultr.com/products/object-storage/
VULTR_OBJECT_STORAGE_ENDPOINT=https://ewr1.vultrobjects.com
VULTR_OBJECT_STORAGE_REGION=ewr1
VULTR_OBJECT_STORAGE_BUCKET=여기에_버킷_이름
VULTR_OBJECT_STORAGE_ACCESS_KEY=여기에_Access_Key
VULTR_OBJECT_STORAGE_SECRET_KEY=여기에_Secret_Key
# 브라우저에 줄 공개 URL 접두사. 비우면 ENDPOINT/BUCKET으로 조합해 쓰며, CDN·커스텀 도메인이면 여기만 바꿔도 됩니다.
VULTR_OBJECT_STORAGE_PUBLIC_BASE_URL=https://ewr1.vultrobjects.com/여기에_버킷_이름
