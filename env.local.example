# 로컬 테스트용 — backend/.env 에 아래를 맞추거나 추가하세요.
# PostgreSQL: docker compose -f docker-compose.local.yml up -d
# DATABASE_URL 은 포트 5433 (docker-compose.local.yml 기준)

DATABASE_URL="postgresql://boogibooks:boogibooks_local_dev@localhost:5433/boogibooks"
PORT=3000
JWT_SECRET="로컬용_임의_문자열_32자_이상_권장"
FRONTEND_URL="http://localhost:8080"

# Discord OAuth (개발자 포털에서 Redirect: http://localhost:3000/auth/discord/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="http://localhost:3000/auth/discord/callback"
DISCORD_GUILD_ID=

# 선택: 봇/서재 연동 테스트 시
BOT_INTERNAL_SECRET="로컬에서_임의_문자열"
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 부깃아웃 이미지 업로드 테스트 시 (없으면 업로드 API는 503)
VULTR_OBJECT_STORAGE_ENDPOINT=
VULTR_OBJECT_STORAGE_REGION=ewr1
VULTR_OBJECT_STORAGE_BUCKET=
VULTR_OBJECT_STORAGE_ACCESS_KEY=
VULTR_OBJECT_STORAGE_SECRET_KEY=
VULTR_OBJECT_STORAGE_PUBLIC_BASE_URL=
